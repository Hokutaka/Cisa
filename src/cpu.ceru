// Cisa - 32-bit virtual CPU simulator
//
// まずはCPUの基本的な動きを理解するための、とても小さいCPU。
// 現時点では性能や実用性よりも、
// 「CPUの中で何が起きているのかをコードから追えること」を優先している。
//
// このCPUは1命令を次の3段階で実行する:
//
//   Fetch   : ROMから命令を読む
//   Decode  : 命令の各bitを読み解く
//   Execute : 実際の処理を行う
//
// 今は1回の step() で1命令を丸ごと実行する。
// 実際のCPUのようにFetch / Decode / Executeを
// クロックごとの段階へ分割しているわけではない。
//
// -----------------------------------------------------------------------------
// 命令形式
// -----------------------------------------------------------------------------
//
// 命令はすべて32bit固定長。
//
// RRR形式:
//
//   31        24 23        16 15         8 7          0
//   +-----------+------------+-------------+------------+
//   |  opcode   |     rd     |     rs1     |    rs2     |
//   +-----------+------------+-------------+------------+
//
//   opcode : 何の命令か
//   rd     : 結果を書き込むレジスタ
//   rs1    : 第1入力レジスタ
//   rs2    : 第2入力レジスタ
//
// ADDなどで使う。
//
//
// RI16形式:
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |     rd     |      immediate:16        |
//   +-----------+------------+--------------------------+
//
// MOVIなどで使う。
// 下位16bitを即値として扱う。
//
//
// R形式:
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |    reg     |          unused          |
//   +-----------+------------+--------------------------+
//
// OUTなどで使う。
//
//
// -----------------------------------------------------------------------------
// v0 ISA
// -----------------------------------------------------------------------------
//
// MOVI rd, imm
//   16bitの即値をレジスタへ入れる。
//
// ADD rd, rs1, rs2
//   rs1 + rs2 を計算し、rdへ書き込む。
//
// OUT reg
//   レジスタの値を表示する。
//   将来的にはmemory mapped I/Oなどへ置き換えるかもしれない。
//
// HALT
//   CPUを停止する.
//

// -----------------------------------------------------------------------------
// CPU全体の定数
// -----------------------------------------------------------------------------

// 汎用レジスタは r0 ～ r7 の8本。
const REGISTER_COUNT: i64 = 8;

// 今のテストプログラムは5命令。
// ROMを固定長配列にしている都合で、長さも型の一部になる。
const ROM_SIZE: i64 = 5;


// -----------------------------------------------------------------------------
// bit mask
// -----------------------------------------------------------------------------

// 8bitだけ残すためのmask。
//
// 255 = 0b11111111
const BYTE_MASK_U32: u32 = 255u32;

// 16bitだけ残すためのmask。
//
// 65535 = 0xffff
const IMMEDIATE_MASK_U32: u32 = 65535u32;

// 32bit整数の最大値。
//
// ADDでは一度u64へ広げて計算したあと、
// この値より大きければCarryが発生したと判断する。
const U32_MAX_U64: u64 = 4294967295u64;


// -----------------------------------------------------------------------------
// opcode
// -----------------------------------------------------------------------------

// opcodeは命令の種類を表す番号。
//
// 命令の最上位8bitに格納する。
//
// 例:
//
//   MOVI = 1
//   ADD  = 2
//
// なら、命令の先頭8bitを見るだけで
// CPUは何を実行すればいいのか判断できる。

const OP_MOVI: u8 = 1;
const OP_ADD: u8 = 2;
const OP_OUT: u8 = 3;

// 255は0xff。
// 通常の命令から離した値にしているだけで、
// 今のところ特別な理由があるわけではない。
const OP_HALT: u8 = 255;


// -----------------------------------------------------------------------------
// CPU state
// -----------------------------------------------------------------------------

// CPUが現在持っている状態。
//
// CPUというのは結局、
// 「いくつかの状態を持っていて、命令を実行するたびに次の状態へ進むもの」
// と考えることができる。
//
// step() は
//
//   Cpu -> Cpu
//
// のように、現在のCPU状態を受け取って
// 次のCPU状態を返す。

type Cpu {
    // General Purpose Registers.
    //
    // r0 ～ r7。
    //
    // それぞれ32bitの値を保持する。
    regs: [u32; REGISTER_COUNT],

    // Program Counter.
    //
    // 次に実行する命令がROMの何番目にあるかを示す。
    //
    // 今のCisaでは「byte address」ではなく
    // 「命令番号」をそのまま持っている。
    //
    // 例えば:
    //
    //   pc = 0 -> 1個目の命令
    //   pc = 1 -> 2個目の命令
    //
    // 実行が終わると通常は pc + 1 する。
    pc: u32,

    // Zero flag.
    //
    // 最後にレジスタへ書いた値が0ならtrue。
    //
    // 将来的にJZなどの条件分岐で使う予定。
    zero: bool,

    // Carry flag.
    //
    // ADDなどで32bitを超える桁あふれが起きた場合にtrue。
    //
    // Ceruneの通常の整数演算ではoverflowすると停止するため、
    // CPUらしいwraparoundを再現するには明示的に処理する必要がある。
    carry: bool,

    // HALT命令が実行されたか。
    //
    // trueになったらCPUの実行ループを終了する。
    halted: bool,
}


// -----------------------------------------------------------------------------
// Instruction encoder
// -----------------------------------------------------------------------------
//
// 人間が扱いやすい
//
//   MOVI r0, 10
//
// のような情報を、CPUが読む32bitの値へ変換する。
//
// 今はAssemblerがないので、
// Ceruneの関数を使って命令を直接組み立てている。

fn encode_movi(rd: u8, immediate: u16) -> u32 {
    // MOVI形式:
    //
    // [ opcode:8 | rd:8 | immediate:16 ]
    //
    // opcodeを24bit左へずらすと最上位8bitへ入る。
    //
    // rdは16bit左へずらして、その次の8bitへ入れる。
    //
    // immediateはそのまま下位16bitへ置く。

    return (u32(OP_MOVI) << 24)
        | (u32(rd) << 16)
        | u32(immediate);
}

fn encode_add(rd: u8, rs1: u8, rs2: u8) -> u32 {
    // ADD形式:
    //
    // [ opcode:8 | rd:8 | rs1:8 | rs2:8 ]
    //
    // それぞれの値を必要な位置まで左シフトして、
    // ORで一つの32bit整数へまとめる。

    return (u32(OP_ADD) << 24)
        | (u32(rd) << 16)
        | (u32(rs1) << 8)
        | u32(rs2);
}

fn encode_out(reg: u8) -> u32 {
    // OUT形式:
    //
    // [ opcode:8 | reg:8 | unused:16 ]
    //
    // 今は下位16bitを使わないので0のまま。

    return (u32(OP_OUT) << 24)
        | (u32(reg) << 16);
}

fn encode_halt() -> u32 {
    // HALTはoperandを必要としない。
    //
    // 最上位8bitへopcodeだけ入れる。

    return u32(OP_HALT) << 24;
}


// -----------------------------------------------------------------------------
// Instruction decoder
// -----------------------------------------------------------------------------

fn decode_opcode(instruction: u32) -> u8 {
    // opcodeはbit 31..24にある。
    //
    // 24bit右へずらすことで下位8bitへ移動する。
    //
    //   instruction
    //   0x02020001
    //
    //          >> 24
    //
    //   0x00000002
    //
    // 最後に255とのANDで8bitだけ残す。

    return u8((instruction >> 24) & BYTE_MASK_U32);
}

fn decode_rd(instruction: u32) -> u8 {
    // rdはbit 23..16。
    //
    // 16bit右へずらしてから下位8bitだけ残す。

    return u8((instruction >> 16) & BYTE_MASK_U32);
}

fn decode_rs1(instruction: u32) -> u8 {
    // rs1はbit 15..8。

    return u8((instruction >> 8) & BYTE_MASK_U32);
}

fn decode_rs2(instruction: u32) -> u8 {
    // rs2は一番下の8bitなので、
    // shiftせずmaskだけで取り出せる。

    return u8(instruction & BYTE_MASK_U32);
}


// -----------------------------------------------------------------------------
// Register helper
// -----------------------------------------------------------------------------

fn register_index(field: u8) -> i64 {
    // CPUには8本しかレジスタがない。
    //
    // 8本なら必要な番号は0～7なので、
    // 下位3bitだけあれば表現できる。
    //
    //   0 = 000
    //   1 = 001
    //   ...
    //   7 = 111
    //
    // 7とのANDで0～7へ丸めている。
    //
    // NOTE:
    // 今の実装では不正なレジスタ番号をエラーにせず、
    // 下位3bitへ丸めてしまう。
    //
    // 例えば 8 は 0 として扱われる。
    //
    // 将来的には「不正命令」として停止させた方が
    // CPUとしては分かりやすいかもしれない。

    return i64(field & 7u8);
}


// -----------------------------------------------------------------------------
// Register write
// -----------------------------------------------------------------------------

fn write_register(
    cpu: Cpu,
    reg: u8,
    value: u32,
    next_pc: u32,
    carry: bool,
) -> Cpu {
    // Ceruneの配列は値として扱われる。
    //
    // そのため現在のregister配列をコピーしてから、
    // 書き込み先のレジスタだけ変更する。

    mut regs: [u32; REGISTER_COUNT] = cpu.regs;

    // 指定されたregisterへ結果を書き込む。
    regs[register_index(reg)] = value;

    // CPU state全体の新しい値を作る。
    //
    // ..cpu で既存のfieldを引き継ぎ、
    // 変更が必要なところだけ上書きする。
    return Cpu {
        ..cpu,

        regs: regs,

        // 通常の命令なら次の命令へ進む。
        pc: next_pc,

        // 書き込んだ値が0ならZero flagを立てる。
        zero: value == 0,

        // ADDなどから渡されたCarry flagを保存する。
        carry: carry,
    };
}


// -----------------------------------------------------------------------------
// Execute one instruction
// -----------------------------------------------------------------------------

fn step(cpu: Cpu, rom: [u32; ROM_SIZE]) -> Cpu {
    // すでにHALTしているCPUなら何もしない。
    //
    // step()を呼んでも状態をそのまま返す。
    if cpu.halted {
        return cpu;
    }


    // -------------------------------------------------------------------------
    // FETCH
    // -------------------------------------------------------------------------
    //
    // Program Counterが指しているROMの位置から
    // 32bit命令を1個読み込む。

    index: i64 = i64(cpu.pc);

    // PCがROMの外へ出ていたら、
    // 存在しない命令を読もうとしている。
    //
    // 今は簡単にエラー表示してCPUを停止する。
    if index >= array_len(rom) {
        print("pc out of range");

        return Cpu {
            ..cpu,
            halted: true,
        };
    }

    // これが今回実行する32bit命令。
    instruction: u32 = rom[index];


    // -------------------------------------------------------------------------
    // DECODE
    // -------------------------------------------------------------------------
    //
    // 命令の最上位8bitを読んで、
    // 何の命令なのか判断する。

    opcode: u8 = decode_opcode(instruction);


    // -------------------------------------------------------------------------
    // EXECUTE : MOVI
    // -------------------------------------------------------------------------

    if opcode == OP_MOVI {
        // MOVIでは下位16bitを即値として使う。
        //
        // [ opcode | rd | immediate ]
        //
        // 65535 = 0xffffなので、
        // 上位16bitを捨てて下位16bitだけ取り出す。
        value: u32 = instruction & IMMEDIATE_MASK_U32;

        // MOVIはregisterへ値を書くだけ。
        //
        // carry flagは変更しないことにしている。
        //
        // MOVIでcarryを保持するか消すかは
        // CPUのISA設計として自由に決められる部分。
        return write_register(
            cpu,
            decode_rd(instruction),
            value,
            cpu.pc + 1,
            cpu.carry,
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : ADD
    // -------------------------------------------------------------------------

    if opcode == OP_ADD {
        // rs1が指しているregisterの値を読む。
        left: u32 = cpu.regs[
            register_index(decode_rs1(instruction))
        ];

        // rs2が指しているregisterの値を読む。
        right: u32 = cpu.regs[
            register_index(decode_rs2(instruction))
        ];


        // ---------------------------------------------------------------------
        // 32bit addition
        // ---------------------------------------------------------------------
        //
        // 普通の32bit CPUなら、
        //
        //   0xffffffff + 1
        //
        // は
        //
        //   result = 0x00000000
        //   carry  = 1
        //
        // になる。
        //
        // しかしCeruneのu32加算は、
        // u32の範囲を超えるとoverflowとして停止する。
        //
        // そこで一度u64へ広げてから計算する。
        //
        // u32 + u32 の最大値は
        //
        //   0xffffffff + 0xffffffff
        //
        // なので、u64なら安全に保持できる。

        wide: u64 = u64(left) + u64(right);


        // CPUのregisterへ書き込めるのは32bitだけ。
        //
        // 下位32bitだけを残して結果とする。
        //
        // 4294967295 = 0xffffffff
        value: u32 = u32(wide & U32_MAX_U64);


        // 32bit最大値を超えていたらCarry発生。
        carry: bool = wide > U32_MAX_U64;


        // 計算結果をrdへ書き込む。
        //
        // write_register()側でZero flagも更新される。
        return write_register(
            cpu,
            decode_rd(instruction),
            value,
            cpu.pc + 1,
            carry,
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : OUT
    // -------------------------------------------------------------------------

    if opcode == OP_OUT {
        // OUT命令ではrdと同じ位置の8bitを
        // 出力対象registerとして使っている。
        //
        // 現在はCeruneのprintへ直接出している。
        //
        // 本格的に仮想コンピュータ化するなら、
        // 将来的にはmemory mapped I/Oなどへ置き換えたい。

        print(
            cpu.regs[
                register_index(decode_rd(instruction))
            ]
        );

        // OUTはCPU registerやflagを変更しない。
        //
        // PCだけ次へ進める。
        return Cpu {
            ..cpu,
            pc: cpu.pc + 1,
        };
    }


    // -------------------------------------------------------------------------
    // EXECUTE : HALT
    // -------------------------------------------------------------------------

    if opcode == OP_HALT {
        // HALTしたCPUは以後step()しても何もしない。
        //
        // PCはそのままにしている。
        return Cpu {
            ..cpu,
            halted: true,
        };
    }


    // -------------------------------------------------------------------------
    // Unknown instruction
    // -------------------------------------------------------------------------
    //
    // どのopcodeにも一致しなかった。
    //
    // 現段階では「不正命令例外」のような仕組みはないので、
    // opcodeを表示してCPUを停止する。

    print("unknown opcode");
    print(opcode);

    return Cpu {
        ..cpu,
        halted: true,
    };
}


// -----------------------------------------------------------------------------
// Test ROM
// -----------------------------------------------------------------------------
//
// まだAssemblerは存在しないので、
// encode_*()関数を使って直接machine codeを作っている。
//
// 人間向けに書けば、次のプログラム:
//
//   MOVI r0, 10
//   MOVI r1, 20
//   ADD  r2, r0, r1
//   OUT  r2
//   HALT
//
// 実行結果:
//
//   30
//
// registerの変化:
//
//   最初
//
//     r0 = 0
//     r1 = 0
//     r2 = 0
//
//   MOVI r0, 10
//
//     r0 = 10
//
//   MOVI r1, 20
//
//     r1 = 20
//
//   ADD r2, r0, r1
//
//     r2 = 30
//
//   OUT r2
//
//     30を表示
//
//   HALT
//
//     CPU停止

program: [u32; ROM_SIZE] = [
    encode_movi(0u8, 10u16),
    encode_movi(1u8, 20u16),
    encode_add(2u8, 0u8, 1u8),
    encode_out(2u8),
    encode_halt(),
];


// -----------------------------------------------------------------------------
// Initial CPU state
// -----------------------------------------------------------------------------

mut cpu: Cpu = Cpu {
    // 起動時は全registerを0にする。
    regs: [
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
    ],

    // 最初の命令から実行する。
    pc: 0,

    // 初期registerはすべて0なので、
    // とりあえずZero flagもtrueから開始している。
    //
    // CPU仕様としてどうするかは今後決めてもいい。
    zero: true,

    // 起動時にはCarryなし。
    carry: false,

    // まだHALTしていない。
    halted: false,
};


// -----------------------------------------------------------------------------
// CPU execution loop
// -----------------------------------------------------------------------------

// 何命令実行したかを数える。
//
// HALTを忘れたROMや、将来JMPを実装したときの無限ループで
// simulator自体が永遠に動き続けないよう、実行回数に上限を設ける。

mut cycles: i64 = 0;


// CPUがHALTするか、100命令実行するまで繰り返す。
//
// 現在は「1 step = 1 cycle」と呼んでいるが、
// 実CPUの1クロックを正確に表しているわけではない。
//
// 将来pipelineやcycle accurate simulationを始めた場合は、
// この意味を整理する必要がある。

while !cpu.halted && cycles < 100 {
    // Fetch -> Decode -> Execute を1回行う。
    cpu = step(cpu, program);

    // 実行した命令数を増やす。
    cycles = cycles + 1;
}


// 100命令実行してもHALTしなかった場合。
//
// 無限ループなどの可能性があるため、
// simulator側で強制的に実行を終了する。

if !cpu.halted {
    print("cycle limit reached");
}