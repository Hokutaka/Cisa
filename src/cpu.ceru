// Cisa - 32-bit virtual CPU simulator
//
// まずはCPUの基本的な動きを理解するための、とても小さいCPU。
//
// 現時点では性能や実用性よりも、
// 「CPUの中で何が起きているのかをコードから追えること」
// を優先している。
//
// このCPUは1命令を次の3段階で実行する:
//
//   Fetch   : ROMから命令を読む
//   Decode  : 命令の各bitを読み解く
//   Execute : 実際の処理を行う
//
// 今は1回の step() で1命令を丸ごと実行する。
//
// 実際のCPUのようにFetch / Decode / Executeを
// クロックごとの段階へ分割しているわけではない。
//
// -----------------------------------------------------------------------------
// 今回追加したもの
// -----------------------------------------------------------------------------
//
//   SUB
//   JMP
//   JZ
//
// これによって、Cisa自身がProgram Counterを書き換えて
// 同じ命令列を繰り返し実行できるようになった。
//
// つまり、単純に
//
//   命令1
//   命令2
//   命令3
//
// と上から下へ実行するだけではなく、
//
//   loop:
//       ...
//       JMP loop
//
// のようなプログラムを動かせる。
//
//
// -----------------------------------------------------------------------------
// 命令形式
// -----------------------------------------------------------------------------
//
// 命令はすべて32bit固定長。
//
//
// -----------------------------------------------------------------------------
// RRR形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15         8 7          0
//   +-----------+------------+-------------+------------+
//   |  opcode   |     rd     |     rs1     |    rs2     |
//   +-----------+------------+-------------+------------+
//
//   opcode : 何の命令か
//   rd     : 結果を書き込むレジスタ
//   rs1    : 第1入力レジスタ
//   rs2    : 第2入力レジスタ
//
// ADD / SUB などで使う。
//
//
// -----------------------------------------------------------------------------
// RI16形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |     rd     |      immediate:16        |
//   +-----------+------------+--------------------------+
//
// MOVIなどで使う。
//
// immediateは16bit。
// 現在のMOVIはこれをzero-extendしてu32 registerへ入れる。
//
//
// -----------------------------------------------------------------------------
// R形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |    reg     |          unused          |
//   +-----------+------------+--------------------------+
//
// OUTなどで使う。
//
//
// -----------------------------------------------------------------------------
// J16形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |   unused   |        target:16         |
//   +-----------+------------+--------------------------+
//
// JMP / JZで使う。
//
// targetはbyte addressではない。
//
// 現在のCisaではProgram Counter自体が
//
//   ROM上の命令番号
//
// を表しているため、targetもそのまま命令番号になる。
//
// 例えば:
//
//   JMP 2
//
// なら
//
//   pc = 2
//
// となり、ROMの3番目の命令へ移動する。
//
// まだAssemblerが存在しないため、
//
//   JMP loop
//
// のようなlabelは使えない。
// encode_jmp(2) のように命令番号を直接指定する。
//
//
// -----------------------------------------------------------------------------
// v1 ISA
// -----------------------------------------------------------------------------
//
// MOVI rd, imm
//   16bit即値をrdへ入れる。
//
// ADD rd, rs1, rs2
//   rs1 + rs2 を32bit加算してrdへ入れる。
//   overflowした場合は下位32bitを結果とし、carry=true。
//
// SUB rd, rs1, rs2
//   rs1 - rs2 を32bit減算してrdへ入れる。
//   0未満になる場合は32bitでwraparoundする。
//   borrowが発生した場合はcarry=trueとする。
//
//   NOTE:
//   SUB時のflag semanticsはまだ仮。
//   将来的にCarryとBorrowをどう定義するかは
//   ISA設計として改めて整理してもよい。
//
// JMP target
//   無条件でpcをtargetへ変更する。
//
// JZ target
//   Zero flagがtrueならpcをtargetへ変更する。
//   falseなら次の命令へ進む。
//
// OUT reg
//   registerの値を表示する。
//   将来的にはmemory mapped I/Oなどへ置き換えるかもしれない。
//
// HALT
//   CPUを停止する。
//
//
// -----------------------------------------------------------------------------
// CPU全体の定数
// -----------------------------------------------------------------------------

// 汎用レジスタは r0 ～ r7 の8本。
const REGISTER_COUNT: i64 = 8;

// 今回のテストROMは7命令。
//
//   0: MOVI r0, 3
//   1: MOVI r1, 1
//   2: OUT  r0
//   3: SUB  r0, r0, r1
//   4: JZ   6
//   5: JMP  2
//   6: HALT
//
// ROMを固定長配列にしているため、
// サイズも型の一部になっている。
const ROM_SIZE: i64 = 7;


// -----------------------------------------------------------------------------
// bit mask
// -----------------------------------------------------------------------------

// 8bitだけ残すためのmask。
//
// 255 = 0xff
const BYTE_MASK_U32: u32 = 255u32;

// 16bitだけ残すためのmask。
//
// 65535 = 0xffff
const IMMEDIATE_MASK_U32: u32 = 65535u32;

// 32bit unsigned integerの最大値。
//
// 0xffffffff
const U32_MAX_U64: u64 = 4294967295u64;

// 2^32。
//
// SUBでunderflowしたとき、
// 32bit CPUらしいwraparoundを計算するために使う。
//
// 例えば:
//
//   0 - 1
//
// は数学上:
//
//   -1
//
// だが、32bit unsigned CPUでは:
//
//   0xffffffff
//
// になる。
//
// そのため:
//
//   2^32 + 0 - 1
//
// を計算する。
const U32_MODULO_U64: u64 = 4294967296u64;


// -----------------------------------------------------------------------------
// opcode
// -----------------------------------------------------------------------------

// opcodeは命令の種類を表す番号。
//
// 命令の最上位8bitに格納する。

const OP_MOVI: u8 = 1;
const OP_ADD: u8 = 2;
const OP_OUT: u8 = 3;

const OP_SUB: u8 = 4;
const OP_JMP: u8 = 5;
const OP_JZ: u8 = 6;

// 255 = 0xff
//
// HALTを通常命令から少し離れた値にしている。
// 今のところ特別な意味はない。
const OP_HALT: u8 = 255;


// -----------------------------------------------------------------------------
// CPU state
// -----------------------------------------------------------------------------

// CPUが現在持っている状態。
//
// CPUというのは結局、
//
//   現在の状態
//      ↓
//   命令実行
//      ↓
//   次の状態
//
// を繰り返す機械として考えられる。
//
// step()は概念的には:
//
//   Cpu -> Cpu
//
// というstate transitionになっている。
//
// ROMは外側から渡すため、実際の関数は:
//
//   step(cpu, rom) -> Cpu
//
// となっている。

type Cpu {
    // General Purpose Registers.
    //
    // r0 ～ r7。
    //
    // それぞれ32bit unsigned integerを保持する。
    regs: [u32; REGISTER_COUNT],

    // Program Counter.
    //
    // 次に実行する命令がROMの何番目にあるかを示す。
    //
    // 現在のCisaではbyte addressではなく
    // 「命令番号」をそのまま使う。
    //
    //   pc = 0
    //     -> ROMの1個目
    //
    //   pc = 1
    //     -> ROMの2個目
    //
    // 通常命令ではpc + 1する。
    //
    // JMP / JZでは任意の命令番号へ変更される。
    pc: u32,

    // Zero flag.
    //
    // 最後にregisterへ書き込まれた値が0ならtrue。
    //
    // 今回追加したJZはこのflagを見る。
    //
    // 例えば:
    //
    //   SUB r0, r0, r1
    //
    // の結果が0になればzero=true。
    //
    // 続く
    //
    //   JZ end
    //
    // がbranchする。
    zero: bool,

    // Carry flag.
    //
    // 現在は算術演算時の桁あふれ情報として使う。
    //
    // ADD:
    //
    //   32bitを超えるcarry-outがあればtrue。
    //
    // SUB:
    //
    //   subtractionでborrowが必要ならtrue。
    //
    // NOTE:
    // この意味はまだv1の仮仕様。
    //
    // 実CPUではISAによってSUB時のCarry flagの意味が異なる。
    // 将来的にはきちんと仕様として決める。
    carry: bool,

    // HALT命令が実行されたか。
    //
    // trueならCPUは停止済み。
    //
    // step()をさらに呼んでも状態は変化しない。
    halted: bool,
}


// -----------------------------------------------------------------------------
// Instruction encoder
// -----------------------------------------------------------------------------
//
// まだAssemblerはない。
//
// そのため:
//
//   MOVI r0, 3
//
// のような命令を、Ceruneの関数で直接32bit machine codeへ変換する。

fn encode_movi(rd: u8, immediate: u16) -> u32 {
    // RI16:
    //
    // [ opcode:8 | rd:8 | immediate:16 ]

    return (u32(OP_MOVI) << 24)
        | (u32(rd) << 16)
        | u32(immediate);
}


fn encode_add(rd: u8, rs1: u8, rs2: u8) -> u32 {
    // RRR:
    //
    // [ opcode:8 | rd:8 | rs1:8 | rs2:8 ]

    return (u32(OP_ADD) << 24)
        | (u32(rd) << 16)
        | (u32(rs1) << 8)
        | u32(rs2);
}


fn encode_sub(rd: u8, rs1: u8, rs2: u8) -> u32 {
    // ADDと同じRRR形式。
    //
    // [ opcode:8 | rd:8 | rs1:8 | rs2:8 ]

    return (u32(OP_SUB) << 24)
        | (u32(rd) << 16)
        | (u32(rs1) << 8)
        | u32(rs2);
}


fn encode_out(reg: u8) -> u32 {
    // R:
    //
    // [ opcode:8 | reg:8 | unused:16 ]

    return (u32(OP_OUT) << 24)
        | (u32(reg) << 16);
}


fn encode_jmp(target: u16) -> u32 {
    // J16:
    //
    // [ opcode:8 | unused:8 | target:16 ]
    //
    // targetはROMの命令番号。

    return (u32(OP_JMP) << 24)
        | u32(target);
}


fn encode_jz(target: u16) -> u32 {
    // J16:
    //
    // [ opcode:8 | unused:8 | target:16 ]

    return (u32(OP_JZ) << 24)
        | u32(target);
}


fn encode_halt() -> u32 {
    // HALTはoperandを持たない。
    //
    // 最上位8bitへopcodeだけ入れる。

    return u32(OP_HALT) << 24;
}


// -----------------------------------------------------------------------------
// Instruction decoder
// -----------------------------------------------------------------------------

fn decode_opcode(instruction: u32) -> u8 {
    // opcodeはbit 31..24。
    //
    // 24bit右shiftして下位8bitだけ残す。

    return u8(
        (instruction >> 24) & BYTE_MASK_U32
    );
}


fn decode_rd(instruction: u32) -> u8 {
    // rdはbit 23..16。

    return u8(
        (instruction >> 16) & BYTE_MASK_U32
    );
}


fn decode_rs1(instruction: u32) -> u8 {
    // rs1はbit 15..8。

    return u8(
        (instruction >> 8) & BYTE_MASK_U32
    );
}


fn decode_rs2(instruction: u32) -> u8 {
    // rs2はbit 7..0。

    return u8(
        instruction & BYTE_MASK_U32
    );
}


fn decode_immediate16(instruction: u32) -> u16 {
    // 下位16bitを取り出す。
    //
    // MOVIのimmediateやJMP/JZのtargetに使う。

    return u16(
        instruction & IMMEDIATE_MASK_U32
    );
}


// -----------------------------------------------------------------------------
// Register helper
// -----------------------------------------------------------------------------

fn register_index(field: u8) -> i64 {
    // CPUにはregisterが8本しかない。
    //
    // 0～7なので下位3bitで表せる。
    //
    // 現在は:
    //
    //   field & 7
    //
    // で強制的に0～7へ丸めている。
    //
    // そのため:
    //
    //   register field = 8
    //
    // のような不正値も:
    //
    //   8 & 7 = 0
    //
    // となってr0として扱われてしまう。
    //
    // これはかなり雑。
    //
    // 将来的には不正なregister numberを
    // illegal instructionとして停止させる方がよいかもしれない。

    return i64(field & 7u8);
}


// -----------------------------------------------------------------------------
// Register write
// -----------------------------------------------------------------------------

fn write_register(
    cpu: Cpu,
    reg: u8,
    value: u32,
    next_pc: u32,
    carry: bool,
) -> Cpu {
    // Ceruneのarrayはvalueとして扱われる。
    //
    // そのため元のregister arrayをコピーして、
    // 書き込み対象だけ変更する。

    mut regs: [u32; REGISTER_COUNT] = cpu.regs;

    regs[register_index(reg)] = value;

    // CPU stateを新しく作る。
    //
    // ..cpuで変更しないfieldを引き継ぐ。

    return Cpu {
        ..cpu,

        regs: regs,

        // 次に実行する命令。
        pc: next_pc,

        // 書き込まれた値が0ならZero flagを立てる。
        zero: value == 0,

        // 算術演算から渡されたflag。
        carry: carry,
    };
}


// -----------------------------------------------------------------------------
// Execute one instruction
// -----------------------------------------------------------------------------

fn step(cpu: Cpu, rom: [u32; ROM_SIZE]) -> Cpu {
    // HALT済みなら何もしない。
    //
    // step()を何度呼んでも同じ状態を返す。

    if cpu.halted {
        return cpu;
    }


    // -------------------------------------------------------------------------
    // FETCH
    // -------------------------------------------------------------------------
    //
    // Program Counterが示す位置から32bit instructionを読む。

    index: i64 = i64(cpu.pc);

    // Program CounterがROMの外を指していたら停止。
    //
    // JMPなどが不正なtargetへ飛んだ場合も、
    // 次のstep()でここへ来る。

    if index >= array_len(rom) {
        print("pc out of range");

        return Cpu {
            ..cpu,
            halted: true,
        };
    }

    instruction: u32 = rom[index];


    // -------------------------------------------------------------------------
    // DECODE
    // -------------------------------------------------------------------------

    opcode: u8 = decode_opcode(instruction);


    // -------------------------------------------------------------------------
    // EXECUTE : MOVI
    // -------------------------------------------------------------------------

    if opcode == OP_MOVI {
        // MOVI rd, imm
        //
        // immediateは16bit。
        //
        // 現在はsigned immediateではなく、
        // 単純にzero-extendしてu32へする。

        value: u32 = u32(
            decode_immediate16(instruction)
        );

        // MOVIではcarry flagを変更しない。
        //
        // Zero flagはwrite_register()によって更新される。

        return write_register(
            cpu,
            decode_rd(instruction),
            value,
            cpu.pc + 1,
            cpu.carry,
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : ADD
    // -------------------------------------------------------------------------

    if opcode == OP_ADD {
        left: u32 = cpu.regs[
            register_index(
                decode_rs1(instruction)
            )
        ];

        right: u32 = cpu.regs[
            register_index(
                decode_rs2(instruction)
            )
        ];


        // ---------------------------------------------------------------------
        // 32bit addition
        // ---------------------------------------------------------------------
        //
        // 普通の32bit CPUなら:
        //
        //   0xffffffff + 1
        //
        // は:
        //
        //   result = 0x00000000
        //   carry  = true
        //
        // になる。
        //
        // しかしCeruneのu32 arithmeticはcheckedなので、
        //
        //   left + right
        //
        // をそのままu32で実行するとoverflow時に停止する。
        //
        // そこで先にu64へ広げて計算する。

        wide: u64 = u64(left) + u64(right);

        // CPU registerへ入るのは下位32bitだけ。

        value: u32 = u32(
            wide & U32_MAX_U64
        );

        // u32の最大値を超えていたらcarry-out。

        carry: bool = wide > U32_MAX_U64;

        return write_register(
            cpu,
            decode_rd(instruction),
            value,
            cpu.pc + 1,
            carry,
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : SUB
    // -------------------------------------------------------------------------

    if opcode == OP_SUB {
        left: u32 = cpu.regs[
            register_index(
                decode_rs1(instruction)
            )
        ];

        right: u32 = cpu.regs[
            register_index(
                decode_rs2(instruction)
            )
        ];


        // ---------------------------------------------------------------------
        // 32bit subtraction
        // ---------------------------------------------------------------------
        //
        // Ceruneではunsigned subtractionもchecked。
        //
        // そのため:
        //
        //   0u32 - 1u32
        //
        // はCPUのようにwraparoundせず、
        // underflowとして停止する。
        //
        // しかしCisaでは普通の32bit CPUらしく:
        //
        //   0x00000000 - 0x00000001
        //
        //       ↓
        //
        //   0xffffffff
        //
        // にしたい。


        // left >= rightなら普通に引き算できる。
        //
        // underflowは起きない。

        if left >= right {
            value: u32 = left - right;

            return write_register(
                cpu,
                decode_rd(instruction),
                value,
                cpu.pc + 1,

                // borrowなし
                false,
            );
        }


        // left < rightの場合はborrowが必要。
        //
        // 直接:
        //
        //   left - right
        //
        // をするとCerune側がunderflowする。
        //
        // そこでu64を使って:
        //
        //   2^32 + left - right
        //
        // を計算する。
        //
        // 例:
        //
        //   left  = 0
        //   right = 1
        //
        //   4294967296 + 0 - 1
        //
        //     = 4294967295
        //     = 0xffffffff
        //
        // となる。

        wrapped: u64 =
            U32_MODULO_U64
            + u64(left)
            - u64(right);

        value: u32 = u32(
            wrapped & U32_MAX_U64
        );

        return write_register(
            cpu,
            decode_rd(instruction),
            value,
            cpu.pc + 1,

            // borrowあり
            true,
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : JMP
    // -------------------------------------------------------------------------

    if opcode == OP_JMP {
        // JMP target
        //
        // 無条件branch。
        //
        // 今のtargetはROM上の命令番号そのもの。
        //
        // 例えば:
        //
        //   encode_jmp(2)
        //
        // は:
        //
        //   pc = 2
        //
        // にする。

        target: u32 = u32(
            decode_immediate16(instruction)
        );

        return Cpu {
            ..cpu,
            pc: target,
        };
    }


    // -------------------------------------------------------------------------
    // EXECUTE : JZ
    // -------------------------------------------------------------------------

    if opcode == OP_JZ {
        // JZ target
        //
        // Zero flagがtrueならbranchする。
        //
        // falseなら普通に次の命令へ進む。

        if cpu.zero {
            target: u32 = u32(
                decode_immediate16(instruction)
            );

            return Cpu {
                ..cpu,
                pc: target,
            };
        }

        return Cpu {
            ..cpu,
            pc: cpu.pc + 1,
        };
    }


    // -------------------------------------------------------------------------
    // EXECUTE : OUT
    // -------------------------------------------------------------------------

    if opcode == OP_OUT {
        // OUT reg
        //
        // 今はCeruneのprint()を直接呼ぶ。
        //
        // 将来的には:
        //
        //   memory mapped I/O
        //
        // やdevice abstractionを作るかもしれない。

        print(
            cpu.regs[
                register_index(
                    decode_rd(instruction)
                )
            ]
        );

        // OUTはregisterもflagも変更しない。
        //
        // PCだけ進める。

        return Cpu {
            ..cpu,
            pc: cpu.pc + 1,
        };
    }


    // -------------------------------------------------------------------------
    // EXECUTE : HALT
    // -------------------------------------------------------------------------

    if opcode == OP_HALT {
        // CPU停止。
        //
        // PCはHALT命令自身を指したままにする。

        return Cpu {
            ..cpu,
            halted: true,
        };
    }


    // -------------------------------------------------------------------------
    // Unknown instruction
    // -------------------------------------------------------------------------
    //
    // 知らないopcodeだった。
    //
    // 現在はexceptionやtrap vectorを持っていないため、
    // エラー表示してそのまま停止する。

    print("unknown opcode");
    print(opcode);

    return Cpu {
        ..cpu,
        halted: true,
    };
}


// -----------------------------------------------------------------------------
// Test ROM
// -----------------------------------------------------------------------------
//
// 今回はbranchを使ってcountdown loopを作る。
//
// 人間向けに書くと:
//
//   MOVI r0, 3
//   MOVI r1, 1
//
// loop:
//   OUT  r0
//   SUB  r0, r0, r1
//   JZ   end
//   JMP  loop
//
// end:
//   HALT
//
//
// ROM上の命令番号:
//
//   0  MOVI r0, 3
//   1  MOVI r1, 1
//   2  OUT  r0        <- loop
//   3  SUB  r0,r0,r1
//   4  JZ   6
//   5  JMP  2
//   6  HALT           <- end
//
//
// 実行結果:
//
//   3
//   2
//   1
//
//
// CPU stateの変化:
//
// --------------------------------------------------
//
// 最初:
//
//   r0 = 0
//   r1 = 0
//
// --------------------------------------------------
//
// MOVI r0, 3
//
//   r0 = 3
//   zero = false
//
// --------------------------------------------------
//
// MOVI r1, 1
//
//   r1 = 1
//   zero = false
//
// --------------------------------------------------
//
// OUT r0
//
//   print 3
//
// --------------------------------------------------
//
// SUB r0, r0, r1
//
//   3 - 1 = 2
//
//   r0 = 2
//   zero = false
//
// --------------------------------------------------
//
// JZ 6
//
//   zero=falseなのでbranchしない。
//
// --------------------------------------------------
//
// JMP 2
//
//   pc=2へ戻る。
//
// --------------------------------------------------
//
// OUT r0
//
//   print 2
//
// --------------------------------------------------
//
// SUB r0, r0, r1
//
//   2 - 1 = 1
//
// --------------------------------------------------
//
// JMP 2
//
// --------------------------------------------------
//
// OUT r0
//
//   print 1
//
// --------------------------------------------------
//
// SUB r0, r0, r1
//
//   1 - 1 = 0
//
//   zero=true
//
// --------------------------------------------------
//
// JZ 6
//
//   zero=trueなのでbranch。
//
//   pc=6
//
// --------------------------------------------------
//
// HALT
//
// CPU停止。


program: [u32; ROM_SIZE] = [
    // 0
    encode_movi(
        0u8,
        3u16,
    ),

    // 1
    encode_movi(
        1u8,
        1u16,
    ),

    // 2 : loop
    encode_out(
        0u8,
    ),

    // 3
    encode_sub(
        0u8,
        0u8,
        1u8,
    ),

    // 4
    //
    // zero=trueなら6番のHALTへ。
    encode_jz(
        6u16,
    ),

    // 5
    //
    // loopの先頭である2番へ戻る。
    encode_jmp(
        2u16,
    ),

    // 6 : end
    encode_halt(),
];


// -----------------------------------------------------------------------------
// Initial CPU state
// -----------------------------------------------------------------------------

mut cpu: Cpu = Cpu {
    // r0 ～ r7
    //
    // 起動時は全部0。

    regs: [
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
    ],

    // ROMの0番から開始。

    pc: 0,

    // 初期registerが全部0なので、
    // とりあえずtrueにしている。
    //
    // reset時のflag値については
    // 将来的にISA仕様として決めてもよい。

    zero: true,

    // 起動直後なのでcarry/borrowなし。

    carry: false,

    // CPUはまだ動作中。

    halted: false,
};


// -----------------------------------------------------------------------------
// CPU execution loop
// -----------------------------------------------------------------------------

// 何命令実行したか。
//
// branchを実装したので、
// HALTのないROMを実行すると本当に無限loopできるようになった。
//
// simulator側まで永遠に動き続けないよう、
// safetyとして最大100命令で止める。

mut cycles: i64 = 0;


// CPUがHALTするか、
// 最大100命令に到達するまでstep()する。
//
// 現在は:
//
//   1 step = 1 cycle
//
// と呼んでいるが、これは正確には:
//
//   1 step = 1 instruction
//
// に近い。
//
// 実際のhardware clockとはまだ対応していない。
//
// 将来cycle accurate modelやpipelineを作る場合には、
// cycleという名前も整理する必要がある。

while !cpu.halted && cycles < 100 {
    cpu = step(
        cpu,
        program,
    );

    cycles = cycles + 1;
}


// -----------------------------------------------------------------------------
// Execution limit
// -----------------------------------------------------------------------------

// 100命令実行してもHALTしなかった場合。
//
// 例えば:
//
// loop:
//   JMP loop
//
// のようなROMを実行するとここへ来る。

if !cpu.halted {
    print("cycle limit reached");
}