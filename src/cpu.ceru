// Cisa - 32-bit virtual CPU simulator
//
// まずはCPUの基本的な動きを理解するための、とても小さいCPU。
//
// 現時点では性能や実用性よりも、
// 「CPUの中で何が起きているのかをコードから追えること」
// を優先している。
//
// このCPUは1命令を次の3段階で実行する:
//
//   Fetch   : ROMから命令を読む
//   Decode  : 命令の各bitを読み解く
//   Execute : 実際の処理を行う
//
// 今は1回の step() で1命令を丸ごと実行する。
//
// 実際のCPUのようにFetch / Decode / Executeを
// クロックごとの段階へ分割しているわけではない。
//
//
// -----------------------------------------------------------------------------
// 今回追加したもの
// -----------------------------------------------------------------------------
//
//   RAM
//   LOAD
//   STORE
//
// これまでのCisaはCPU内部のregisterだけで状態を持っていた。
//
// 今回はCPUの外側に小さなRAMを追加し、
//
//   LOAD  rd, address
//   STORE rs, address
//
// でregisterとRAMの間を値が移動できるようにする。
//
// CPUとRAMをまとめた状態はMachineとして持つ。
//
//   Machine
//   ├─ Cpu
//   │  ├─ Registers
//   │  ├─ Program Counter
//   │  └─ Flags
//   │
//   └─ RAM
//
// まだbyte-addressed memoryではない。
//
// addressはRAM上のu32要素番号をそのまま表す。
//
// 例えば:
//
//   address = 0
//       -> RAM[0]
//
//   address = 1
//       -> RAM[1]
//
// なのでaddress=1は「1byte先」ではなく、
// 「2個目の32bit word」を意味する。
//
//
// -----------------------------------------------------------------------------
// 命令形式
// -----------------------------------------------------------------------------
//
// 命令はすべて32bit固定長。
//
//
// -----------------------------------------------------------------------------
// RRR形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15         8 7          0
//   +-----------+------------+-------------+------------+
//   |  opcode   |     rd     |     rs1     |    rs2     |
//   +-----------+------------+-------------+------------+
//
//   opcode : 何の命令か
//   rd     : 結果を書き込むレジスタ
//   rs1    : 第1入力レジスタ
//   rs2    : 第2入力レジスタ
//
// ADD / SUB などで使う。
//
//
// -----------------------------------------------------------------------------
// RI16形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |   rd/rs    |      immediate:16        |
//   +-----------+------------+--------------------------+
//
// MOVI / LOAD / STOREなどで使う。
//
// MOVI:
//
//   [ opcode | rd | immediate ]
//
// LOAD:
//
//   [ opcode | rd | address ]
//
// STORE:
//
//   [ opcode | rs | address ]
//
// 下位16bitの意味は命令ごとに異なる。
//
//
// -----------------------------------------------------------------------------
// R形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |    reg     |          unused          |
//   +-----------+------------+--------------------------+
//
// OUTなどで使う。
//
//
// -----------------------------------------------------------------------------
// J16形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |   unused   |        target:16         |
//   +-----------+------------+--------------------------+
//
// JMP / JZで使う。
//
// targetはbyte addressではない。
//
// 現在のCisaではProgram Counter自体が
//
//   ROM上の命令番号
//
// を表しているため、targetもそのまま命令番号になる。
//
// 例えば:
//
//   JMP 3
//
// なら:
//
//   pc = 3
//
// となり、ROMの4番目の命令へ移動する。
//
// まだAssemblerが存在しないため:
//
//   JMP loop
//
// のようなlabelは使えない。
//
// encode_jmp(3) のように命令番号を直接指定する。
//
//
// -----------------------------------------------------------------------------
// v2 ISA
// -----------------------------------------------------------------------------
//
// MOVI rd, imm
//   16bit即値をrdへ入れる。
//
// ADD rd, rs1, rs2
//   rs1 + rs2 を32bit加算してrdへ入れる。
//   overflowした場合は下位32bitを結果とし、carry=true。
//
// SUB rd, rs1, rs2
//   rs1 - rs2 を32bit減算してrdへ入れる。
//   0未満になる場合は32bitでwraparoundする。
//   borrowが発生した場合はcarry=trueとする。
//
//   NOTE:
//   SUB時のflag semanticsはまだ仮。
//   将来的にCarryとBorrowをどう定義するかは
//   ISA設計として改めて整理してもよい。
//
// JMP target
//   無条件でpcをtargetへ変更する。
//
// JZ target
//   Zero flagがtrueならpcをtargetへ変更する。
//   falseなら次の命令へ進む。
//
// LOAD rd, address
//   RAM[address]の値をrdへ読み込む。
//
//   現在のCisaではregister writeによって
//   Zero flagが更新される設計なので、LOADでもZero flagを更新する。
//
//   Carry flagは変更しない。
//
// STORE rs, address
//   rsの値をRAM[address]へ書き込む。
//
//   registerもflagも変更しない。
//
// OUT reg
//   registerの値を表示する。
//
//   将来的にはmemory mapped I/Oなどへ
//   置き換えるかもしれない。
//
// HALT
//   CPUを停止する。
//
//
// -----------------------------------------------------------------------------
// CPU / Machine全体の定数
// -----------------------------------------------------------------------------

// 汎用レジスタは r0 ～ r7 の8本。
const REGISTER_COUNT: i64 = 8;


// RAMは16 word。
//
// 1 word = u32。
//
// 現在はword-addressedなので、
//
//   0 ～ 15
//
// をそのまま配列indexとして使う。
const RAM_SIZE: i64 = 16;


// 今回のテストROMは10命令。
//
//   0: MOVI  r0, 3
//   1: STORE r0, 0
//   2: MOVI  r1, 1
//   3: LOAD  r0, 0
//   4: OUT   r0
//   5: SUB   r0, r0, r1
//   6: STORE r0, 0
//   7: JZ    9
//   8: JMP   3
//   9: HALT
//
// ROMを固定長配列にしているため、
// サイズも型の一部になっている。
const ROM_SIZE: i64 = 10;


// -----------------------------------------------------------------------------
// bit mask
// -----------------------------------------------------------------------------

// 8bitだけ残すためのmask。
//
// 255 = 0xff
const BYTE_MASK_U32: u32 = 255u32;


// 16bitだけ残すためのmask。
//
// 65535 = 0xffff
const IMMEDIATE_MASK_U32: u32 = 65535u32;


// 32bit unsigned integerの最大値。
//
// 0xffffffff
const U32_MAX_U64: u64 = 4294967295u64;


// 2^32。
//
// SUBでunderflowしたとき、
// 32bit CPUらしいwraparoundを計算するために使う。
//
// 例えば:
//
//   0 - 1
//
// は数学上:
//
//   -1
//
// だが、32bit unsigned CPUでは:
//
//   0xffffffff
//
// になる。
//
// そのため:
//
//   2^32 + 0 - 1
//
// を計算する。
const U32_MODULO_U64: u64 = 4294967296u64;


// -----------------------------------------------------------------------------
// opcode
// -----------------------------------------------------------------------------

// opcodeは命令の種類を表す番号。
//
// 命令の最上位8bitに格納する。

const OP_MOVI: u8 = 1;
const OP_ADD: u8 = 2;
const OP_OUT: u8 = 3;

const OP_SUB: u8 = 4;
const OP_JMP: u8 = 5;
const OP_JZ: u8 = 6;

const OP_LOAD: u8 = 7;
const OP_STORE: u8 = 8;


// 255 = 0xff
//
// HALTを通常命令から少し離れた値にしている。
// 今のところ特別な意味はない。
const OP_HALT: u8 = 255;


// -----------------------------------------------------------------------------
// CPU state
// -----------------------------------------------------------------------------

// CPUが現在持っている内部状態。
//
// CPUというのは結局:
//
//   現在の状態
//      ↓
//   命令実行
//      ↓
//   次の状態
//
// を繰り返す機械として考えられる。
//
// ただし今回からRAMも追加されたため、
// CPUだけでは「コンピュータ全体の状態」ではなくなった。
//
// そのためstep()では:
//
//   Machine -> Machine
//
// というstate transitionを扱う。

type Cpu {
    // General Purpose Registers.
    //
    // r0 ～ r7。
    //
    // それぞれ32bit unsigned integerを保持する。
    regs: [u32; REGISTER_COUNT],


    // Program Counter.
    //
    // 次に実行する命令がROMの何番目にあるかを示す。
    //
    // 現在のCisaではbyte addressではなく
    // 「命令番号」をそのまま使う。
    //
    //   pc = 0
    //     -> ROMの1個目
    //
    //   pc = 1
    //     -> ROMの2個目
    //
    // 通常命令ではpc + 1する。
    //
    // JMP / JZでは任意の命令番号へ変更される。
    pc: u32,


    // Zero flag.
    //
    // 最後にregisterへ書き込まれた値が0ならtrue。
    //
    // 例えば:
    //
    //   SUB r0, r0, r1
    //
    // の結果が0になればzero=true。
    //
    // 続く:
    //
    //   JZ end
    //
    // がbranchする。
    zero: bool,


    // Carry flag.
    //
    // 現在は算術演算時の桁あふれ情報として使う。
    //
    // ADD:
    //
    //   32bitを超えるcarry-outがあればtrue。
    //
    // SUB:
    //
    //   subtractionでborrowが必要ならtrue。
    //
    // NOTE:
    //
    // この意味はまだ仮仕様。
    //
    // 実CPUではISAによってSUB時のCarry flagの意味が異なる。
    // 将来的にはきちんと仕様として決める。
    carry: bool,


    // HALT命令が実行されたか。
    //
    // trueならCPUは停止済み。
    //
    // step()をさらに呼んでも状態は変化しない。
    halted: bool,
}


// -----------------------------------------------------------------------------
// Machine state
// -----------------------------------------------------------------------------

// CPUとRAMをまとめた「仮想コンピュータ全体」の状態。
//
// 今後:
//
//   Timer
//   Controller
//   Framebuffer
//   Sound?
//
// などを追加する場合は、
// このMachineへdevice stateが増えていく想定。

type Machine {
    cpu: Cpu,


    // とても小さいRAM。
    //
    // 16個のu32を保持する。
    //
    // 現在はword-addressedなので:
//
//   ram[0]
//   ram[1]
//   ...
//
// をLOAD / STORE命令から直接指定する。
    ram: [u32; RAM_SIZE],
}


// -----------------------------------------------------------------------------
// Instruction encoder
// -----------------------------------------------------------------------------
//
// まだAssemblerはない。
//
// そのため:
//
//   MOVI r0, 3
//
// のような命令を、Ceruneの関数で直接32bit machine codeへ変換する。

fn encode_movi(rd: u8, immediate: u16) -> u32 {
    // RI16:
    //
    // [ opcode:8 | rd:8 | immediate:16 ]

    return (u32(OP_MOVI) << 24)
        | (u32(rd) << 16)
        | u32(immediate);
}


fn encode_add(rd: u8, rs1: u8, rs2: u8) -> u32 {
    // RRR:
    //
    // [ opcode:8 | rd:8 | rs1:8 | rs2:8 ]

    return (u32(OP_ADD) << 24)
        | (u32(rd) << 16)
        | (u32(rs1) << 8)
        | u32(rs2);
}


fn encode_sub(rd: u8, rs1: u8, rs2: u8) -> u32 {
    // ADDと同じRRR形式。
    //
    // [ opcode:8 | rd:8 | rs1:8 | rs2:8 ]

    return (u32(OP_SUB) << 24)
        | (u32(rd) << 16)
        | (u32(rs1) << 8)
        | u32(rs2);
}


fn encode_out(reg: u8) -> u32 {
    // R:
    //
    // [ opcode:8 | reg:8 | unused:16 ]

    return (u32(OP_OUT) << 24)
        | (u32(reg) << 16);
}


fn encode_jmp(target: u16) -> u32 {
    // J16:
    //
    // [ opcode:8 | unused:8 | target:16 ]
    //
    // targetはROMの命令番号。

    return (u32(OP_JMP) << 24)
        | u32(target);
}


fn encode_jz(target: u16) -> u32 {
    // J16:
    //
    // [ opcode:8 | unused:8 | target:16 ]

    return (u32(OP_JZ) << 24)
        | u32(target);
}


fn encode_load(rd: u8, address: u16) -> u32 {
    // RI16:
    //
    // [ opcode:8 | rd:8 | address:16 ]

    return (u32(OP_LOAD) << 24)
        | (u32(rd) << 16)
        | u32(address);
}


fn encode_store(reg: u8, address: u16) -> u32 {
    // RI16:
    //
    // [ opcode:8 | reg:8 | address:16 ]
    //
    // MOVIのrd fieldと同じ場所を、
    // STOREではsource registerとして利用する。

    return (u32(OP_STORE) << 24)
        | (u32(reg) << 16)
        | u32(address);
}


fn encode_halt() -> u32 {
    // HALTはoperandを持たない。
    //
    // 最上位8bitへopcodeだけ入れる。

    return u32(OP_HALT) << 24;
}


// -----------------------------------------------------------------------------
// Instruction decoder
// -----------------------------------------------------------------------------

fn decode_opcode(instruction: u32) -> u8 {
    // opcodeはbit 31..24。
    //
    // 24bit右shiftして下位8bitだけ残す。

    return u8(
        (instruction >> 24) & BYTE_MASK_U32
    );
}


fn decode_rd(instruction: u32) -> u8 {
    // rdはbit 23..16。
    //
    // STOREでは同じbit位置をsource registerとして使う。

    return u8(
        (instruction >> 16) & BYTE_MASK_U32
    );
}


fn decode_rs1(instruction: u32) -> u8 {
    // rs1はbit 15..8。

    return u8(
        (instruction >> 8) & BYTE_MASK_U32
    );
}


fn decode_rs2(instruction: u32) -> u8 {
    // rs2はbit 7..0。

    return u8(
        instruction & BYTE_MASK_U32
    );
}


fn decode_immediate16(instruction: u32) -> u16 {
    // 下位16bitを取り出す。
    //
    // 用途:
    //
    //   MOVI       immediate
    //   JMP / JZ   target
    //   LOAD       address
    //   STORE      address

    return u16(
        instruction & IMMEDIATE_MASK_U32
    );
}


// -----------------------------------------------------------------------------
// Register helper
// -----------------------------------------------------------------------------

fn register_index(field: u8) -> i64 {
    // CPUにはregisterが8本しかない。
    //
    // 0～7なので下位3bitで表せる。
    //
    // 現在は:
    //
    //   field & 7
    //
    // で強制的に0～7へ丸めている。
    //
    // そのため:
    //
    //   register field = 8
    //
    // のような不正値も:
    //
    //   8 & 7 = 0
    //
    // となってr0として扱われてしまう。
    //
    // これはかなり雑。
    //
    // 将来的には不正なregister numberを
    // illegal instructionとして停止させる方がよいかもしれない。

    return i64(field & 7u8);
}


// -----------------------------------------------------------------------------
// Register write
// -----------------------------------------------------------------------------

fn write_register(
    cpu: Cpu,
    reg: u8,
    value: u32,
    next_pc: u32,
    carry: bool,
) -> Cpu {
    // Ceruneのarrayはvalueとして扱われる。
    //
    // そのため元のregister arrayをコピーして、
    // 書き込み対象だけ変更する。

    mut regs: [u32; REGISTER_COUNT] = cpu.regs;

    regs[register_index(reg)] = value;


    // CPU stateを新しく作る。
    //
    // ..cpuで変更しないfieldを引き継ぐ。

    return Cpu {
        ..cpu,

        regs: regs,

        // 次に実行する命令。
        pc: next_pc,

        // 書き込まれた値が0ならZero flagを立てる。
        zero: value == 0,

        // 算術演算から渡されたflag。
        carry: carry,
    };
}


// -----------------------------------------------------------------------------
// Machine helper
// -----------------------------------------------------------------------------

fn with_cpu(machine: Machine, cpu: Cpu) -> Machine {
    // RAMなどCPU以外の状態はそのまま引き継ぎ、
    // CPUだけを置き換える。

    return Machine {
        ..machine,
        cpu: cpu,
    };
}


// -----------------------------------------------------------------------------
// Execute one instruction
// -----------------------------------------------------------------------------

fn step(machine: Machine, rom: [u32; ROM_SIZE]) -> Machine {
    // 今回の命令を実行するCPU state。
    //
    // Machineから取り出して扱う。

    cpu: Cpu = machine.cpu;


    // HALT済みなら何もしない。
    //
    // step()を何度呼んでも同じMachineを返す。

    if cpu.halted {
        return machine;
    }


    // -------------------------------------------------------------------------
    // FETCH
    // -------------------------------------------------------------------------
    //
    // Program Counterが示す位置から32bit instructionを読む。

    index: i64 = i64(cpu.pc);


    // Program CounterがROMの外を指していたら停止。
    //
    // JMPなどが不正なtargetへ飛んだ場合も、
    // 次のstep()でここへ来る。

    if index >= array_len(rom) {
        print("pc out of range");

        return with_cpu(
            machine,

            Cpu {
                ..cpu,
                halted: true,
            },
        );
    }


    instruction: u32 = rom[index];


    // -------------------------------------------------------------------------
    // DECODE
    // -------------------------------------------------------------------------

    opcode: u8 = decode_opcode(instruction);


    // -------------------------------------------------------------------------
    // EXECUTE : MOVI
    // -------------------------------------------------------------------------

    if opcode == OP_MOVI {
        // MOVI rd, imm
        //
        // immediateは16bit。
        //
        // 現在はsigned immediateではなく、
        // 単純にzero-extendしてu32へする。

        value: u32 = u32(
            decode_immediate16(instruction)
        );


        // MOVIではcarry flagを変更しない。
        //
        // Zero flagはwrite_register()によって更新される。

        return with_cpu(
            machine,

            write_register(
                cpu,
                decode_rd(instruction),
                value,
                cpu.pc + 1,
                cpu.carry,
            ),
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : ADD
    // -------------------------------------------------------------------------

    if opcode == OP_ADD {
        left: u32 = cpu.regs[
            register_index(
                decode_rs1(instruction)
            )
        ];

        right: u32 = cpu.regs[
            register_index(
                decode_rs2(instruction)
            )
        ];


        // ---------------------------------------------------------------------
        // 32bit addition
        // ---------------------------------------------------------------------
        //
        // 普通の32bit CPUなら:
        //
        //   0xffffffff + 1
        //
        // は:
        //
        //   result = 0x00000000
        //   carry  = true
        //
        // になる。
        //
        // しかしCeruneのu32 arithmeticはcheckedなので、
        // そのままu32で計算するとoverflow時に停止する。
        //
        // そこで先にu64へ広げて計算する。

        wide: u64 = u64(left) + u64(right);


        // CPU registerへ入るのは下位32bitだけ。

        value: u32 = u32(
            wide & U32_MAX_U64
        );


        // u32の最大値を超えていたらcarry-out。

        carry: bool = wide > U32_MAX_U64;


        return with_cpu(
            machine,

            write_register(
                cpu,
                decode_rd(instruction),
                value,
                cpu.pc + 1,
                carry,
            ),
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : SUB
    // -------------------------------------------------------------------------

    if opcode == OP_SUB {
        left: u32 = cpu.regs[
            register_index(
                decode_rs1(instruction)
            )
        ];

        right: u32 = cpu.regs[
            register_index(
                decode_rs2(instruction)
            )
        ];


        // ---------------------------------------------------------------------
        // 32bit subtraction
        // ---------------------------------------------------------------------
        //
        // Ceruneではunsigned subtractionもchecked。
        //
        // そのため:
        //
        //   0u32 - 1u32
        //
        // はCPUのようにwraparoundせず、
        // underflowとして停止する。
        //
        // しかしCisaでは普通の32bit CPUらしく:
        //
        //   0x00000000 - 0x00000001
        //
        //       ↓
        //
        //   0xffffffff
        //
        // にしたい。


        // left >= rightなら普通に引き算できる。

        if left >= right {
            value: u32 = left - right;

            return with_cpu(
                machine,

                write_register(
                    cpu,
                    decode_rd(instruction),
                    value,
                    cpu.pc + 1,

                    // borrowなし
                    false,
                ),
            );
        }


        // left < rightの場合はborrowが必要。
        //
        // 直接:
        //
        //   left - right
        //
        // をするとCerune側がunderflowする。
        //
        // そこで:
        //
        //   2^32 + left - right
        //
        // を計算する。
        //
        // 例:
        //
        //   left  = 0
        //   right = 1
        //
        //   4294967296 + 0 - 1
        //
        //     = 4294967295
        //     = 0xffffffff

        wrapped: u64 =
            U32_MODULO_U64
            + u64(left)
            - u64(right);


        value: u32 = u32(
            wrapped & U32_MAX_U64
        );


        return with_cpu(
            machine,

            write_register(
                cpu,
                decode_rd(instruction),
                value,
                cpu.pc + 1,

                // borrowあり
                true,
            ),
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : JMP
    // -------------------------------------------------------------------------

    if opcode == OP_JMP {
        // JMP target
        //
        // 無条件branch。

        target: u32 = u32(
            decode_immediate16(instruction)
        );


        return with_cpu(
            machine,

            Cpu {
                ..cpu,
                pc: target,
            },
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : JZ
    // -------------------------------------------------------------------------

    if opcode == OP_JZ {
        // JZ target
        //
        // Zero flagがtrueならbranchする。
        //
        // falseなら普通に次の命令へ進む。

        if cpu.zero {
            target: u32 = u32(
                decode_immediate16(instruction)
            );


            return with_cpu(
                machine,

                Cpu {
                    ..cpu,
                    pc: target,
                },
            );
        }


        return with_cpu(
            machine,

            Cpu {
                ..cpu,
                pc: cpu.pc + 1,
            },
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : LOAD
    // -------------------------------------------------------------------------

    if opcode == OP_LOAD {
        // LOAD rd, address
        //
        // addressは下位16bit。
        //
        // 現在はRAM上のword indexとしてそのまま使う。

        address: i64 = i64(
            decode_immediate16(instruction)
        );


        // 存在しないRAMを読もうとした場合。
        //
        // 今はmemory faultやexception vectorを持っていないので、
        // messageを出してCPUを停止する。

        if address >= array_len(machine.ram) {
            print("ram address out of range");

            return with_cpu(
                machine,

                Cpu {
                    ..cpu,
                    halted: true,
                },
            );
        }


        value: u32 = machine.ram[address];


        // LOADはregisterへ値を書き込む。
        //
        // 現在のCisaではregister writeによって
        // Zero flagを更新する設計なので、
        // LOADでもZero flagが更新される。
        //
        // Carry flagはそのまま保持する。

        return with_cpu(
            machine,

            write_register(
                cpu,
                decode_rd(instruction),
                value,
                cpu.pc + 1,
                cpu.carry,
            ),
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : STORE
    // -------------------------------------------------------------------------

    if opcode == OP_STORE {
        // STORE rs, address
        //
        // instruction形式としては:
        //
        //   [ opcode | reg | address ]
        //
        // になっている。
        //
        // decode_rd()という名前のhelperを使っているが、
        // STOREではこのfieldはdestinationではなく
        // source registerとして扱う。

        address: i64 = i64(
            decode_immediate16(instruction)
        );


        // 存在しないRAMへ書き込もうとした場合。

        if address >= array_len(machine.ram) {
            print("ram address out of range");

            return with_cpu(
                machine,

                Cpu {
                    ..cpu,
                    halted: true,
                },
            );
        }


        // Ceruneの固定長arrayはvalueなので、
        // 現在のRAMをコピーしてから1要素だけ変更する。

        mut ram: [u32; RAM_SIZE] = machine.ram;


        ram[address] = cpu.regs[
            register_index(
                decode_rd(instruction)
            )
        ];


        // STOREはregisterを書き換えない。
        //
        // flagも変更しない。
        //
        // これは今回かなり重要。
        //
        // 例えば:
        //
        //   SUB   r0, r0, r1
        //   STORE r0, 0
        //   JZ    end
        //
        // という命令列では、
        //
        // SUBによってzero=trueになったあと、
        // STOREを挟んでもzero=trueを保持してほしい。
        //
        // そのためSTOREではpcだけ進める。

        return Machine {
            ..machine,

            cpu: Cpu {
                ..cpu,
                pc: cpu.pc + 1,
            },

            ram: ram,
        };
    }


    // -------------------------------------------------------------------------
    // EXECUTE : OUT
    // -------------------------------------------------------------------------

    if opcode == OP_OUT {
        // OUT reg
        //
        // 今はCeruneのprint()を直接呼ぶ。
        //
        // 将来的には:
        //
        //   memory mapped I/O
        //
        // やdevice abstractionを作るかもしれない。

        print(
            cpu.regs[
                register_index(
                    decode_rd(instruction)
                )
            ]
        );


        // OUTはregisterもflagも変更しない。
        //
        // PCだけ進める。

        return with_cpu(
            machine,

            Cpu {
                ..cpu,
                pc: cpu.pc + 1,
            },
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : HALT
    // -------------------------------------------------------------------------

    if opcode == OP_HALT {
        // CPU停止。
        //
        // PCはHALT命令自身を指したままにする。

        return with_cpu(
            machine,

            Cpu {
                ..cpu,
                halted: true,
            },
        );
    }


    // -------------------------------------------------------------------------
    // Unknown instruction
    // -------------------------------------------------------------------------
    //
    // 知らないopcodeだった。
    //
    // 現在はexceptionやtrap vectorを持っていないため、
    // エラー表示してそのまま停止する。

    print("unknown opcode");
    print(opcode);


    return with_cpu(
        machine,

        Cpu {
            ..cpu,
            halted: true,
        },
    );
}


// -----------------------------------------------------------------------------
// Test ROM
// -----------------------------------------------------------------------------
//
// 今回はcountdownの値をregisterだけに置かず、
// RAM[0]へ保存する。
//
// 人間向けに書くと:
//
//   MOVI  r0, 3
//   STORE r0, 0
//
//   MOVI  r1, 1
//
// loop:
//   LOAD  r0, 0
//   OUT   r0
//   SUB   r0, r0, r1
//   STORE r0, 0
//   JZ    end
//   JMP   loop
//
// end:
//   HALT
//
//
// -----------------------------------------------------------------------------
// RAMの変化
// -----------------------------------------------------------------------------
//
// 最初:
//
//   RAM[0] = 0
//
// MOVI r0, 3
// STORE r0, 0
//
//   RAM[0] = 3
//
// 1回目:
//
//   LOAD r0, 0
//       r0 = 3
//
//   OUT r0
//       print 3
//
//   SUB r0, r0, r1
//       r0 = 2
//
//   STORE r0, 0
//       RAM[0] = 2
//
// 2回目:
//
//   RAM[0] = 1
//
// 3回目:
//
//   SUB
//       r0 = 0
//       zero = true
//
//   STORE
//       RAM[0] = 0
//       zero = true のまま
//
//   JZ
//       HALTへbranch
//
//
// 最終的に:
//
//   RAM[0] = 0
//
//
// -----------------------------------------------------------------------------
// ROM上の命令番号
// -----------------------------------------------------------------------------
//
//   0  MOVI  r0, 3
//   1  STORE r0, 0
//   2  MOVI  r1, 1
//
//   3  LOAD  r0, 0      <- loop
//   4  OUT   r0
//   5  SUB   r0,r0,r1
//   6  STORE r0, 0
//   7  JZ    9
//   8  JMP   3
//
//   9  HALT             <- end
//
//
// -----------------------------------------------------------------------------
// 実行結果
// -----------------------------------------------------------------------------
//
//   3
//   2
//   1

program: [u32; ROM_SIZE] = [
    // 0
    //
    // r0 = 3
    encode_movi(
        0u8,
        3u16,
    ),


    // 1
    //
    // RAM[0] = r0
    encode_store(
        0u8,
        0u16,
    ),


    // 2
    //
    // r1 = 1
    encode_movi(
        1u8,
        1u16,
    ),


    // 3 : loop
    //
    // r0 = RAM[0]
    encode_load(
        0u8,
        0u16,
    ),


    // 4
    //
    // print r0
    encode_out(
        0u8,
    ),


    // 5
    //
    // r0 = r0 - r1
    encode_sub(
        0u8,
        0u8,
        1u8,
    ),


    // 6
    //
    // RAM[0] = r0
    encode_store(
        0u8,
        0u16,
    ),


    // 7
    //
    // zero=trueなら9番のHALTへ。
    encode_jz(
        9u16,
    ),


    // 8
    //
    // loopの先頭である3番へ戻る。
    encode_jmp(
        3u16,
    ),


    // 9 : end
    encode_halt(),
];


// -----------------------------------------------------------------------------
// Initial machine state
// -----------------------------------------------------------------------------

mut machine: Machine = Machine {
    cpu: Cpu {
        // r0 ～ r7
        //
        // 起動時は全部0。

        regs: [
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
        ],


        // ROMの0番から開始。

        pc: 0,


        // 初期registerが全部0なので、
        // とりあえずtrueにしている。
        //
        // reset時のflag値については
        // 将来的にISA仕様として決めてもよい。

        zero: true,


        // 起動直後なのでcarry/borrowなし。

        carry: false,


        // CPUはまだ動作中。

        halted: false,
    },


    // RAMも起動時はすべて0。

    ram: [
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
    ],
};


// -----------------------------------------------------------------------------
// Machine execution loop
// -----------------------------------------------------------------------------

// 何命令実行したか。
//
// branchを実装しているので、
// HALTのないROMを実行すると本当に無限loopできる。
//
// simulator側まで永遠に動き続けないよう、
// safetyとして最大100命令で止める。

mut cycles: i64 = 0;


// CPUがHALTするか、
// 最大100命令に到達するまでstep()する。
//
// 現在は:
//
//   1 step = 1 cycle
//
// と呼んでいるが、これは正確には:
//
//   1 step = 1 instruction
//
// に近い。
//
// 実際のhardware clockとはまだ対応していない。
//
// 将来cycle accurate modelやpipelineを作る場合には、
// cycleという名前も整理する必要がある。

while !machine.cpu.halted && cycles < 100 {
    machine = step(
        machine,
        program,
    );

    cycles = cycles + 1;
}


// -----------------------------------------------------------------------------
// Execution limit
// -----------------------------------------------------------------------------

// 100命令実行してもHALTしなかった場合。
//
// 例えば:
//
// loop:
//   JMP loop
//
// のようなROMを実行するとここへ来る。

if !machine.cpu.halted {
    print("cycle limit reached");
}