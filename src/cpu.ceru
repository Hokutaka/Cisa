// Cisa - 32-bit virtual CPU simulator
//
// まずはCPUの基本的な動きを理解するための、とても小さいCPU。
//
// 現時点では性能や実用性よりも、
// 「CPUの中で何が起きているのかをコードから追えること」
// を優先している。
//
// このCPUは1命令を次の3段階で実行する:
//
//   Fetch   : ROMから命令を読む
//   Decode  : 命令の各bitを読み解く
//   Execute : 実際の処理を行う
//
// 今は1回の step() で1命令を丸ごと実行する。
//
// 実際のCPUのようにFetch / Decode / Executeを
// クロックごとの段階へ分割しているわけではない。
//
//
// -----------------------------------------------------------------------------
// 今回追加したもの
// -----------------------------------------------------------------------------
//
//   Stack Pointer
//   PUSH
//   POP
//
// CisaにはすでにRAMがある。
//
// 今回はそのRAMの上端側をstackとして使う。
//
// RAM_SIZE = 16の場合:
//
//   RAM[0]
//   RAM[1]
//   ...
//   RAM[13]
//   RAM[14]   <- stack
//   RAM[15]   <- stack
//   --------
//   sp = 16   <- empty stack
//
// stackは上のaddressから下方向へ伸びる。
//
// PUSH:
//
//   sp = sp - 1
//   RAM[sp] = value
//
// POP:
//
//   value = RAM[sp]
//   sp = sp + 1
//
// 初期状態では:
//
//   sp = 16
//
// なのでstackは空。
//
// 最初のPUSHで:
//
//   sp = 15
//
// となりRAM[15]へ値を書き込む。
//
//
// -----------------------------------------------------------------------------
// Machine
// -----------------------------------------------------------------------------
//
// 現在のCisa全体:
//
//   Machine
//   ├─ Cpu
//   │  ├─ Registers
//   │  ├─ Program Counter
//   │  ├─ Stack Pointer
//   │  └─ Flags
//   │
//   └─ RAM
//
// stack専用の別memoryを作るのではなく、
// 通常のRAMと同じmemoryを使っている。
//
// 将来的には:
//
//   CALL
//   RET
//
// でreturn addressをこのstackへ保存する予定。
//
//
// -----------------------------------------------------------------------------
// 命令形式
// -----------------------------------------------------------------------------
//
// 命令はすべて32bit固定長。
//
//
// -----------------------------------------------------------------------------
// RRR形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15         8 7          0
//   +-----------+------------+-------------+------------+
//   |  opcode   |     rd     |     rs1     |    rs2     |
//   +-----------+------------+-------------+------------+
//
// ADD / SUBなどで使う。
//
//
// -----------------------------------------------------------------------------
// RI16形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |   rd/rs    |      immediate:16        |
//   +-----------+------------+--------------------------+
//
// MOVI / LOAD / STOREなどで使う。
//
//
// -----------------------------------------------------------------------------
// R形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |    reg     |          unused          |
//   +-----------+------------+--------------------------+
//
// OUT / PUSH / POPなどで使う。
//
//
// -----------------------------------------------------------------------------
// J16形式
// -----------------------------------------------------------------------------
//
//   31        24 23        16 15                       0
//   +-----------+------------+--------------------------+
//   |  opcode   |   unused   |        target:16         |
//   +-----------+------------+--------------------------+
//
// JMP / JZで使う。
//
// targetはbyte addressではない。
//
// 現在のCisaではProgram Counter自体が
// ROM上の命令番号になっている。
//
//
// -----------------------------------------------------------------------------
// v3 ISA
// -----------------------------------------------------------------------------
//
// MOVI rd, imm
//   16bit即値をrdへ入れる。
//
// ADD rd, rs1, rs2
//   rs1 + rs2 を32bit加算してrdへ入れる。
//   overflowした場合はwraparoundする。
//   carry-outがあればcarry=true。
//
// SUB rd, rs1, rs2
//   rs1 - rs2 を32bit減算してrdへ入れる。
//   underflowした場合はwraparoundする。
//   borrowが発生した場合はcarry=true。
//
// JMP target
//   無条件branch。
//
// JZ target
//   Zero flagがtrueならbranch。
//
// LOAD rd, address
//   RAM[address]をrdへ読む。
//
// STORE rs, address
//   rsをRAM[address]へ書く。
//
// PUSH reg
//   regの値をstackへ積む。
//
// POP reg
//   stackの一番上の値をregへ取り出す。
//
// OUT reg
//   regの値を表示する。
//
// HALT
//   CPUを停止する。
//
//
// -----------------------------------------------------------------------------
// CPU / Machine constants
// -----------------------------------------------------------------------------

// r0 ～ r7
const REGISTER_COUNT: i64 = 8;


// RAMは16 word。
//
// 1 word = u32。
const RAM_SIZE: i64 = 16;


// stackが空のときのStack Pointer。
//
// RAMの有効indexは:
//
//   0 .. 15
//
// なので:
//
//   sp = 16
//
// は「stackに何も入っていない」状態として使える。
const STACK_EMPTY_SP: u32 = 16u32;


// 今回のテストROM:
//
//   MOVI r0, 10
//   PUSH r0
//
//   MOVI r0, 20
//   PUSH r0
//
//   POP r1
//   OUT r1
//
//   POP r2
//   OUT r2
//
//   HALT
//
// 合計9命令。
const ROM_SIZE: i64 = 9;


// -----------------------------------------------------------------------------
// bit mask
// -----------------------------------------------------------------------------

// 8bit mask。
const BYTE_MASK_U32: u32 = 255u32;


// 16bit mask。
const IMMEDIATE_MASK_U32: u32 = 65535u32;


// u32最大値。
//
// 0xffffffff
const U32_MAX_U64: u64 = 4294967295u64;


// 2^32。
//
// SUBのwraparoundに使う。
const U32_MODULO_U64: u64 = 4294967296u64;


// -----------------------------------------------------------------------------
// opcode
// -----------------------------------------------------------------------------

const OP_MOVI: u8 = 1;
const OP_ADD: u8 = 2;
const OP_OUT: u8 = 3;

const OP_SUB: u8 = 4;
const OP_JMP: u8 = 5;
const OP_JZ: u8 = 6;

const OP_LOAD: u8 = 7;
const OP_STORE: u8 = 8;

const OP_PUSH: u8 = 9;
const OP_POP: u8 = 10;


// HALT
const OP_HALT: u8 = 255;


// -----------------------------------------------------------------------------
// CPU state
// -----------------------------------------------------------------------------

type Cpu {
    // General Purpose Registers.
    //
    // r0 ～ r7。
    regs: [u32; REGISTER_COUNT],


    // Program Counter.
    //
    // ROM上の命令番号。
    pc: u32,


    // Stack Pointer.
    //
    // stackの一番上を指す。
    //
    // stackが空なら:
    //
    //   sp = 16
    //
    // PUSHすると:
    //
    //   sp = sp - 1
    //
    // POPすると:
    //
    //   sp = sp + 1
    //
    // stackはRAMの上端から下方向へ伸びる。
    sp: u32,


    // Zero flag.
    //
    // 最後にregisterへ書き込まれた値が0ならtrue。
    zero: bool,


    // Carry flag.
    //
    // ADDではcarry-out。
    //
    // SUBでは現在borrowをtrueとしている。
    //
    // SUB時の意味はまだ仮仕様。
    carry: bool,


    // HALT済みか。
    halted: bool,
}


// -----------------------------------------------------------------------------
// Machine state
// -----------------------------------------------------------------------------

// CPUとRAMをまとめた仮想コンピュータ全体。
//
// 今後:
//
//   Timer
//   Controller
//   Framebuffer
//   Sound?
//
// などが増えるなら、このMachineへ追加していく。

type Machine {
    cpu: Cpu,


    // RAM。
    //
    // LOAD / STOREでも使うし、
// PUSH / POPでも同じRAMを使う。
    ram: [u32; RAM_SIZE],
}


// -----------------------------------------------------------------------------
// Instruction encoder
// -----------------------------------------------------------------------------

fn encode_movi(rd: u8, immediate: u16) -> u32 {
    // [ opcode:8 | rd:8 | immediate:16 ]

    return (u32(OP_MOVI) << 24)
        | (u32(rd) << 16)
        | u32(immediate);
}


fn encode_add(rd: u8, rs1: u8, rs2: u8) -> u32 {
    // [ opcode:8 | rd:8 | rs1:8 | rs2:8 ]

    return (u32(OP_ADD) << 24)
        | (u32(rd) << 16)
        | (u32(rs1) << 8)
        | u32(rs2);
}


fn encode_sub(rd: u8, rs1: u8, rs2: u8) -> u32 {
    // [ opcode:8 | rd:8 | rs1:8 | rs2:8 ]

    return (u32(OP_SUB) << 24)
        | (u32(rd) << 16)
        | (u32(rs1) << 8)
        | u32(rs2);
}


fn encode_out(reg: u8) -> u32 {
    // [ opcode:8 | reg:8 | unused:16 ]

    return (u32(OP_OUT) << 24)
        | (u32(reg) << 16);
}


fn encode_jmp(target: u16) -> u32 {
    // [ opcode:8 | unused:8 | target:16 ]

    return (u32(OP_JMP) << 24)
        | u32(target);
}


fn encode_jz(target: u16) -> u32 {
    // [ opcode:8 | unused:8 | target:16 ]

    return (u32(OP_JZ) << 24)
        | u32(target);
}


fn encode_load(rd: u8, address: u16) -> u32 {
    // [ opcode:8 | rd:8 | address:16 ]

    return (u32(OP_LOAD) << 24)
        | (u32(rd) << 16)
        | u32(address);
}


fn encode_store(reg: u8, address: u16) -> u32 {
    // [ opcode:8 | reg:8 | address:16 ]

    return (u32(OP_STORE) << 24)
        | (u32(reg) << 16)
        | u32(address);
}


fn encode_push(reg: u8) -> u32 {
    // [ opcode:8 | reg:8 | unused:16 ]

    return (u32(OP_PUSH) << 24)
        | (u32(reg) << 16);
}


fn encode_pop(reg: u8) -> u32 {
    // [ opcode:8 | reg:8 | unused:16 ]

    return (u32(OP_POP) << 24)
        | (u32(reg) << 16);
}


fn encode_halt() -> u32 {
    return u32(OP_HALT) << 24;
}


// -----------------------------------------------------------------------------
// Instruction decoder
// -----------------------------------------------------------------------------

fn decode_opcode(instruction: u32) -> u8 {
    return u8(
        (instruction >> 24) & BYTE_MASK_U32
    );
}


fn decode_rd(instruction: u32) -> u8 {
    // bit 23..16。
    //
    // 命令によって:
//
//   rd
//   register
//   source register
//
// など意味が変わる。
    return u8(
        (instruction >> 16) & BYTE_MASK_U32
    );
}


fn decode_rs1(instruction: u32) -> u8 {
    return u8(
        (instruction >> 8) & BYTE_MASK_U32
    );
}


fn decode_rs2(instruction: u32) -> u8 {
    return u8(
        instruction & BYTE_MASK_U32
    );
}


fn decode_immediate16(instruction: u32) -> u16 {
    // 用途:
    //
    //   MOVI       immediate
    //   JMP / JZ   target
    //   LOAD       address
    //   STORE      address

    return u16(
        instruction & IMMEDIATE_MASK_U32
    );
}


// -----------------------------------------------------------------------------
// Register helper
// -----------------------------------------------------------------------------

fn register_index(field: u8) -> i64 {
    // CPUにはregisterが8本しかない。
    //
    // 下位3bitだけを使って0～7へ丸める。
    //
    // NOTE:
    //
    // 不正register番号も別registerへaliasしてしまう。
    //
    // 将来的にはillegal instructionとして
    // trapさせた方が分かりやすいかもしれない。

    return i64(field & 7u8);
}


// -----------------------------------------------------------------------------
// Register write
// -----------------------------------------------------------------------------

fn write_register(
    cpu: Cpu,
    reg: u8,
    value: u32,
    next_pc: u32,
    carry: bool,
) -> Cpu {
    // Ceruneのarrayはvalue。
    //
    // register arrayをコピーして1個だけ変更する。

    mut regs: [u32; REGISTER_COUNT] = cpu.regs;

    regs[register_index(reg)] = value;


    return Cpu {
        ..cpu,

        regs: regs,

        pc: next_pc,

        // registerへ書いた値が0ならtrue。
        zero: value == 0,

        carry: carry,
    };
}


// -----------------------------------------------------------------------------
// Machine helper
// -----------------------------------------------------------------------------

fn with_cpu(machine: Machine, cpu: Cpu) -> Machine {
    // RAMをそのまま残し、
    // CPU stateだけ置き換える。

    return Machine {
        ..machine,
        cpu: cpu,
    };
}


// -----------------------------------------------------------------------------
// Execute one instruction
// -----------------------------------------------------------------------------

fn step(machine: Machine, rom: [u32; ROM_SIZE]) -> Machine {
    cpu: Cpu = machine.cpu;


    // すでにHALT済みなら何もしない。

    if cpu.halted {
        return machine;
    }


    // -------------------------------------------------------------------------
    // FETCH
    // -------------------------------------------------------------------------

    index: i64 = i64(cpu.pc);


    // PCがROM外なら停止。

    if index >= array_len(rom) {
        print("pc out of range");

        return with_cpu(
            machine,

            Cpu {
                ..cpu,
                halted: true,
            },
        );
    }


    instruction: u32 = rom[index];


    // -------------------------------------------------------------------------
    // DECODE
    // -------------------------------------------------------------------------

    opcode: u8 = decode_opcode(instruction);


    // -------------------------------------------------------------------------
    // EXECUTE : MOVI
    // -------------------------------------------------------------------------

    if opcode == OP_MOVI {
        value: u32 = u32(
            decode_immediate16(instruction)
        );


        return with_cpu(
            machine,

            write_register(
                cpu,
                decode_rd(instruction),
                value,
                cpu.pc + 1,
                cpu.carry,
            ),
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : ADD
    // -------------------------------------------------------------------------

    if opcode == OP_ADD {
        left: u32 = cpu.regs[
            register_index(
                decode_rs1(instruction)
            )
        ];

        right: u32 = cpu.regs[
            register_index(
                decode_rs2(instruction)
            )
        ];


        // Ceruneのu32 arithmeticはchecked。
        //
        // そこでu64へ広げてから計算する。

        wide: u64 = u64(left) + u64(right);


        // 下位32bit。

        value: u32 = u32(
            wide & U32_MAX_U64
        );


        // u32最大値を超えたらcarry。

        carry: bool = wide > U32_MAX_U64;


        return with_cpu(
            machine,

            write_register(
                cpu,
                decode_rd(instruction),
                value,
                cpu.pc + 1,
                carry,
            ),
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : SUB
    // -------------------------------------------------------------------------

    if opcode == OP_SUB {
        left: u32 = cpu.regs[
            register_index(
                decode_rs1(instruction)
            )
        ];

        right: u32 = cpu.regs[
            register_index(
                decode_rs2(instruction)
            )
        ];


        // underflowしない場合。

        if left >= right {
            value: u32 = left - right;

            return with_cpu(
                machine,

                write_register(
                    cpu,
                    decode_rd(instruction),
                    value,
                    cpu.pc + 1,

                    // borrowなし
                    false,
                ),
            );
        }


        // underflowする場合。
        //
        // Ceruneで直接:
        //
        //   left - right
        //
        // をすると停止する。
        //
        // そのため:
        //
        //   2^32 + left - right
        //
        // とする。

        wrapped: u64 =
            U32_MODULO_U64
            + u64(left)
            - u64(right);


        value: u32 = u32(
            wrapped & U32_MAX_U64
        );


        return with_cpu(
            machine,

            write_register(
                cpu,
                decode_rd(instruction),
                value,
                cpu.pc + 1,

                // borrowあり
                true,
            ),
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : JMP
    // -------------------------------------------------------------------------

    if opcode == OP_JMP {
        target: u32 = u32(
            decode_immediate16(instruction)
        );


        return with_cpu(
            machine,

            Cpu {
                ..cpu,
                pc: target,
            },
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : JZ
    // -------------------------------------------------------------------------

    if opcode == OP_JZ {
        if cpu.zero {
            target: u32 = u32(
                decode_immediate16(instruction)
            );


            return with_cpu(
                machine,

                Cpu {
                    ..cpu,
                    pc: target,
                },
            );
        }


        return with_cpu(
            machine,

            Cpu {
                ..cpu,
                pc: cpu.pc + 1,
            },
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : LOAD
    // -------------------------------------------------------------------------

    if opcode == OP_LOAD {
        address: i64 = i64(
            decode_immediate16(instruction)
        );


        // RAM外なら停止。

        if address >= array_len(machine.ram) {
            print("ram address out of range");

            return with_cpu(
                machine,

                Cpu {
                    ..cpu,
                    halted: true,
                },
            );
        }


        value: u32 = machine.ram[address];


        // LOADはregister write。
        //
        // Zero flagを更新し、
        // Carry flagは保持する。

        return with_cpu(
            machine,

            write_register(
                cpu,
                decode_rd(instruction),
                value,
                cpu.pc + 1,
                cpu.carry,
            ),
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : STORE
    // -------------------------------------------------------------------------

    if opcode == OP_STORE {
        address: i64 = i64(
            decode_immediate16(instruction)
        );


        // RAM外なら停止。

        if address >= array_len(machine.ram) {
            print("ram address out of range");

            return with_cpu(
                machine,

                Cpu {
                    ..cpu,
                    halted: true,
                },
            );
        }


        mut ram: [u32; RAM_SIZE] = machine.ram;


        ram[address] = cpu.regs[
            register_index(
                decode_rd(instruction)
            )
        ];


        // STOREではflagを変更しない。
        //
        // PCだけ進める。

        return Machine {
            ..machine,

            cpu: Cpu {
                ..cpu,
                pc: cpu.pc + 1,
            },

            ram: ram,
        };
    }


    // -------------------------------------------------------------------------
    // EXECUTE : PUSH
    // -------------------------------------------------------------------------

    if opcode == OP_PUSH {
        // PUSH reg
        //
        // stackはRAMの上端から下方向へ伸びる。
        //
        // empty:
        //
        //   sp = 16
        //
        // PUSH:
        //
        //   sp = 15
        //   RAM[15] = value
        //
        // 次のPUSH:
        //
        //   sp = 14
        //   RAM[14] = value


        // sp == 0なら、もう下へ伸ばせない。
        //
        // RAM[0]まで使用済みの状態。

        if cpu.sp == 0u32 {
            print("stack overflow");

            return with_cpu(
                machine,

                Cpu {
                    ..cpu,
                    halted: true,
                },
            );
        }


        // Ceruneのunsigned subtractionはcheckedなので、
        // 必ずsp == 0を検査してから引く。

        next_sp: u32 = cpu.sp - 1u32;


        mut ram: [u32; RAM_SIZE] = machine.ram;


        // PUSH対象registerの値をstackへ保存。

        ram[i64(next_sp)] = cpu.regs[
            register_index(
                decode_rd(instruction)
            )
        ];


        // PUSHはregisterやflagを変更しない。
        //
        // spとpcだけ更新する。

        return Machine {
            ..machine,

            cpu: Cpu {
                ..cpu,

                sp: next_sp,
                pc: cpu.pc + 1,
            },

            ram: ram,
        };
    }


    // -------------------------------------------------------------------------
    // EXECUTE : POP
    // -------------------------------------------------------------------------

    if opcode == OP_POP {
        // POP reg
        //
        // 現在spが指しているstack topを読み、
        // registerへ書き込む。
        //
        // そのあとspを1増やす。


        // sp == 16ならstackは空。
        //
        // >= にしておくことで、
        // 万が一spが不正な値になっていてもRAM外を読まない。

        if cpu.sp >= STACK_EMPTY_SP {
            print("stack underflow");

            return with_cpu(
                machine,

                Cpu {
                    ..cpu,
                    halted: true,
                },
            );
        }


        // stack topを読む。

        value: u32 = machine.ram[
            i64(cpu.sp)
        ];


        // POPはregister writeなので、
        // 現在のCisaのルールではZero flagも更新する。
        //
        // Carry flagは保持する。

        popped_cpu: Cpu = write_register(
            cpu,
            decode_rd(instruction),
            value,
            cpu.pc + 1,
            cpu.carry,
        );


        // POPが成功したのでspを戻す。
        //
        // ここではcpu.sp < 16が確認済みなので、
        // +1してもu32 overflowは起きない。

        return with_cpu(
            machine,

            Cpu {
                ..popped_cpu,
                sp: cpu.sp + 1u32,
            },
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : OUT
    // -------------------------------------------------------------------------

    if opcode == OP_OUT {
        print(
            cpu.regs[
                register_index(
                    decode_rd(instruction)
                )
            ]
        );


        // OUTはregisterやflagを変更しない。
        //
        // PCだけ進める。

        return with_cpu(
            machine,

            Cpu {
                ..cpu,
                pc: cpu.pc + 1,
            },
        );
    }


    // -------------------------------------------------------------------------
    // EXECUTE : HALT
    // -------------------------------------------------------------------------

    if opcode == OP_HALT {
        return with_cpu(
            machine,

            Cpu {
                ..cpu,
                halted: true,
            },
        );
    }


    // -------------------------------------------------------------------------
    // Unknown instruction
    // -------------------------------------------------------------------------

    print("unknown opcode");
    print(opcode);


    return with_cpu(
        machine,

        Cpu {
            ..cpu,
            halted: true,
        },
    );
}


// -----------------------------------------------------------------------------
// Test ROM
// -----------------------------------------------------------------------------
//
// 今回はstackのLIFO動作を確認する。
//
// LIFO:
//
//   Last In
//   First Out
//
// 最後に入れたものが最初に出てくる。
//
//
// 人間向けに書くと:
//
//   MOVI r0, 10
//   PUSH r0
//
//   MOVI r0, 20
//   PUSH r0
//
//   POP  r1
//   OUT  r1
//
//   POP  r2
//   OUT  r2
//
//   HALT
//
//
// -----------------------------------------------------------------------------
// Stackの変化
// -----------------------------------------------------------------------------
//
// 初期状態:
//
//   sp = 16
//
//   stack = empty
//
//
// MOVI r0, 10
//
//   r0 = 10
//
//
// PUSH r0
//
//   sp = 15
//
//   RAM[15] = 10
//
//
// MOVI r0, 20
//
//   r0 = 20
//
//
// PUSH r0
//
//   sp = 14
//
//   RAM[14] = 20
//   RAM[15] = 10
//
//
// POP r1
//
//   r1 = RAM[14]
//
//   r1 = 20
//   sp = 15
//
//
// OUT r1
//
//   20
//
//
// POP r2
//
//   r2 = RAM[15]
//
//   r2 = 10
//   sp = 16
//
//
// OUT r2
//
//   10
//
//
// 最後:
//
//   sp = 16
//
//   stack = empty
//
//
// -----------------------------------------------------------------------------
// 実行結果
// -----------------------------------------------------------------------------
//
//   20
//   10

program: [u32; ROM_SIZE] = [
    // 0
    //
    // r0 = 10
    encode_movi(
        0u8,
        10u16,
    ),


    // 1
    //
    // push 10
    encode_push(
        0u8,
    ),


    // 2
    //
    // r0 = 20
    encode_movi(
        0u8,
        20u16,
    ),


    // 3
    //
    // push 20
    encode_push(
        0u8,
    ),


    // 4
    //
    // r1 = pop()
    //
    // => 20
    encode_pop(
        1u8,
    ),


    // 5
    encode_out(
        1u8,
    ),


    // 6
    //
    // r2 = pop()
    //
    // => 10
    encode_pop(
        2u8,
    ),


    // 7
    encode_out(
        2u8,
    ),


    // 8
    encode_halt(),
];


// -----------------------------------------------------------------------------
// Initial machine state
// -----------------------------------------------------------------------------

mut machine: Machine = Machine {
    cpu: Cpu {
        // r0 ～ r7
        //
        // 起動時は全部0。

        regs: [
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
        ],


        // ROMの0番から開始。

        pc: 0,


        // stackは空。
        //
        // RAM_SIZE=16なので、その1個上を指す。

        sp: STACK_EMPTY_SP,


        // reset時のflag値はまだ仮仕様。

        zero: true,


        // 起動直後なのでcarry/borrowなし。

        carry: false,


        // CPUはまだ動作中。

        halted: false,
    },


    // RAMも起動時はすべて0。
    //
    // 上端側はstackとして使われる。

    ram: [
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
    ],
};


// -----------------------------------------------------------------------------
// Machine execution loop
// -----------------------------------------------------------------------------

mut cycles: i64 = 0;


// HALTするか100命令に達するまで実行する。
//
// 現在は:
//
//   1 step = 1 instruction
//
// であり、実際のhardware clockとはまだ一致しない。

while !machine.cpu.halted && cycles < 100 {
    machine = step(
        machine,
        program,
    );

    cycles = cycles + 1;
}


// -----------------------------------------------------------------------------
// Execution limit
// -----------------------------------------------------------------------------

if !machine.cpu.halted {
    print("cycle limit reached");
}